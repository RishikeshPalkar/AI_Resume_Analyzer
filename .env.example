# =================================================================
# AI Resume Analyzer & Job Matcher - Environment Configuration
# Copy this file to .env and configure values for your environment.
# NEVER commit real credentials, tokens, or private keys to git.
# =================================================================

# -----------------
# DATABASE (MySQL 8.4 LTS)
# -----------------
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/resume_analyzer_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
SPRING_DATASOURCE_USERNAME=analyzer_user
SPRING_DATASOURCE_PASSWORD=analyzer_secret

# -----------------
# AUTHENTICATION & JWT SECURITY
# -----------------
# High-entropy 256-bit (minimum 32-character) secret key
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_ACCESS_EXPIRATION_MS=900000       # 15 minutes
JWT_REFRESH_EXPIRATION_MS=604800000   # 7 days

# -----------------
# SPRING AI & LLM PROVIDER
# -----------------
OPENAI_API_KEY=your-openai-api-key-here
AI_MODEL=gpt-4o-mini
AI_MOCK_FALLBACK=true

# -----------------
# APPLICATION CORS ORIGINS
# -----------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# -----------------
# FRONTEND CONFIGURATION
# -----------------
# Only VITE_ prefixed variables are exposed to the browser
VITE_API_BASE_URL=http://localhost:8080/api/v1
